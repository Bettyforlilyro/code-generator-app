# ============================================================================
# 数据库（PostgreSQL）
# ============================================================================
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name

# ============================================================================
# Flask 应用配置
# ============================================================================
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your_jwt_access_token_secret_key      # JWT Access Token 签名密钥
REFRESH_SECRET_KEY=your_jwt_refresh_token_secret_key  # JWT Refresh Token 签名密钥

# ============================================================================
# 通义千问 LLM（代码生成核心）
# ============================================================================
TONGYI_API_KEY=your_tongyi_api_key
TONGYI_OPENAI_COMPATIBLE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TONGYI_MODEL=qwen-plus

# ============================================================================
# 通义/DashScope 图片生成
# ============================================================================
TONGYI_IMAGE_GEN_API_KEY=your_tongyi_image_gen_api_key
TONGYI_IMAGE_GEN_MODEL=qwen-image-3.0
TONGYI_DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1

# ============================================================================
# Pexels 图片搜索
# ============================================================================
PEXELS_API_KEY=your_pexels_api_key

# ============================================================================
# 图床服务（用于上传截图、Logo、素材图等，获取图片URL）
# ============================================================================
IMAGE_BED_URL=https://your-image-bed-api.com/upload
IMAGE_BED_TOKEN=your_image_bed_token

# ============================================================================
# 截图/文件存储
# ============================================================================
SCREENSHOT_DIR=F:/projects/code-generator-app/backend/generated_apps/screenshots
GENERATE_ROOT=F:/projects/code-generator-app/backend/generated_apps
DEPLOY_ROOT=F:/projects/code-generator-app/backend/generated_apps/deployed
NGINX_PATH=D:\Nginx\nginx.exe